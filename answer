class Solution {
public:
    bool isValidSudoku(vector<vector<char>>& board) {
        bool row[9][9] = {};
        bool col[9][9] = {};
        bool box[9][9] = {};

        for (int i = 0; i < 9; i++) {
            for (int j = 0; j < 9; j++) {
                if (board[i][j] == '.')
                    continue;

                int num = board[i][j] - '1';
                int b = (i / 3) * 3 + j / 3;

                if (row[i][num] || col[j][num] || box[b][num])
                    return false;

                row[i][num] = true;
                col[j][num] = true;
                box[b][num] = true;
            }
        }

        return true;
    }
};

Explaination:

Track each number in its row, column, and 3×3 box. If the same number appears twice in any of them, the board is invalid.
